  "suites": [
    {
      "id": "suite-campusmitra",
      "name": "CampusMitra Full E2E",
      "persistSession": true,
      "parallel": false,
      "timeout": 120,
      "tests": [
        "test-auth",
        "test-chat-ping"
      ]
    }
  ],
  "urls": [
    "http://localhost:5173"
  ],
  "plugins": [],
