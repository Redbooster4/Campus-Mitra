meta {
  name: Update Student Followup Status
  type: http
  seq: 5
}

patch {
  url: {{baseUrl}}/admin/analytics/students/:student_id/followup
  body: json
  auth: bearer
}

params:path {
  student_id: {{studentId}}
}

auth:bearer {
  token: {{token}}
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "followup_status": "Contacted",
    "notes": "Called student. Scheduled for campus counseling session tomorrow.",
    "callback_requested": false
  }
}

tests {
  test("Followup status returns 200 OK", function() {
    expect(res.getStatus()).to.equal(200);
  });
}
