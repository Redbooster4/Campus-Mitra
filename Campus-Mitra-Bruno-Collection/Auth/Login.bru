meta {
  name: Login User
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/auth/login
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "full_name": "Rohan Sharma",
    "password": "password123"
  }
}

tests {
  test("Login returns 200 OK", function() {
    expect(res.getStatus()).to.equal(200);
  });
  
  if (res.getStatus() === 200) {
    const data = res.getBody();
    if (data && data.token) {
      bru.setEnvVar("token", data.token);
    }
    if (data && data.user && data.user.student_id) {
      bru.setEnvVar("studentId", data.user.student_id);
    }
  }
}
